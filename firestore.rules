rules_version = '2';
// Only the planning team can read or edit plans.
// Add or remove Google accounts here, then: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    function team() {
      return request.auth != null && request.auth.token.email in [
        'ben.ahlersmeyer@gmail.com',
        'sam.ahlersmeyer@gmail.com',
        'kaseyneedham92@gmail.com'
        // Next: Janelle
      ];
    }
    match /plans/{id} {
      allow read, write: if team();
    }
  }
}
